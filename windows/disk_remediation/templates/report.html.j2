{% set u = disk_usage %}
{% set pct = u.UsedPct | float %}
{% set level = 'crit' if pct >= disk_report_html_crit_pct | float else ('warn' if pct >= disk_report_html_warn_pct | float else 'ok') %}
{% set large = disk_report.large_files %}
{% set large_mb = large | map(attribute='SizeMB') | map('float') | sum %}
{% set max_mb = (large | map(attribute='SizeMB') | map('float') | max) if large else 1 %}
{% set t = disk_report.temp_summary %}
{% set stale_paths = t.StaleFiles | default([]) | map(attribute='Path') | list %}
{% set reclaim_mb = (t.StaleMB | float) + (large | rejectattr('Path', 'in', stale_paths) | map(attribute='SizeMB') | map('float') | sum) %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Disk Space Review - {{ inventory_hostname | e }}</title>
<style>
  :root {
    --bg: #f4f5f7; --card: #ffffff; --text: #1f2933; --muted: #616e7c;
    --border: #e4e7eb; --accent: #ee0000; --ok: #2e7d32; --warn: #ed8b00; --crit: #c62828;
    --track: #e4e7eb;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 14px/1.5 "Red Hat Text", "Segoe UI", Helvetica, Arial, sans-serif; }
  header { background: #151515; color: #fff; padding: 24px 40px; border-bottom: 4px solid var(--accent); }
  header h1 { margin: 0; font-size: 22px; font-weight: 600; }
  header .sub { color: #b8bbbe; margin-top: 4px; font-size: 13px; }
  main { max-width: 1100px; margin: 0 auto; padding: 28px 40px 48px; }
  .notice { background: #e7f1fa; border-left: 4px solid #0066cc; padding: 12px 16px;
            border-radius: 4px; margin-bottom: 24px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px 20px; }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
  .card .value { font-size: 26px; font-weight: 600; margin-top: 4px; }
  .card .value small { font-size: 14px; color: var(--muted); font-weight: 400; }
  .ok   { color: var(--ok); }   .warn { color: var(--warn); }   .crit { color: var(--crit); }
  section { background: var(--card); border: 1px solid var(--border); border-radius: 8px;
            padding: 20px 24px; margin-bottom: 24px; }
  section h2 { margin: 0 0 4px; font-size: 17px; }
  section .desc { color: var(--muted); margin: 0 0 16px; }
  .usage-bar { height: 22px; background: var(--track); border-radius: 11px; overflow: hidden; }
  .usage-bar > div { height: 100%; border-radius: 11px; }
  .usage-bar .ok { background: var(--ok); } .usage-bar .warn { background: var(--warn); } .usage-bar .crit { background: var(--crit); }
  .usage-legend { position: relative; height: 18px; color: var(--muted); font-size: 12px; margin-top: 6px; }
  .usage-legend span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  .usage-legend span:first-child { transform: none; }
  .usage-legend span:last-child { transform: translateX(-100%); }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted);
       border-bottom: 2px solid var(--border); padding: 8px 10px; }
  td { padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  tr:hover td { background: #fafbfc; }
  td.path { font-family: Consolas, "Courier New", monospace; font-size: 13px; word-break: break-all; }
  td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  td.date { white-space: nowrap; color: var(--muted); }
  .mini { width: 140px; height: 8px; background: var(--track); border-radius: 4px; overflow: hidden; }
  .mini > div { height: 100%; background: #0066cc; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 12px; font-weight: 600; }
  .pill.ok { background: #e8f5e9; } .pill.warn { background: #fff4e5; } .pill.crit { background: #fdecea; }
  .empty { color: var(--muted); font-style: italic; padding: 12px 0; }
  footer { text-align: center; color: var(--muted); font-size: 12px; margin-top: 8px; }
</style>
</head>
<body>
<header>
  <h1>Disk Space Review &mdash; {{ inventory_hostname | e }}</h1>
  <div class="sub">
    Drive {{ u.DriveLetter }}: &middot; Generated {{ now(fmt='%Y-%m-%d %H:%M:%S %Z') }}
    {% if disk_incident_number | length > 0 %} &middot; Incident {{ disk_incident_number | e }}{% endif %}
  </div>
</header>
<main>
  <div class="notice">
    <strong>No changes were made.</strong> This report lists large files and temporary files that are candidates for cleanup.
  </div>

  <div class="cards">
    <div class="card"><div class="label">Used</div><div class="value {{ level }}">{{ u.UsedPct }}<small>%</small></div></div>
    <div class="card"><div class="label">Free</div><div class="value">{{ u.FreeGB }} <small>GB</small></div></div>
    <div class="card"><div class="label">Capacity</div><div class="value">{{ u.SizeGB }} <small>GB</small></div></div>
    <div class="card"><div class="label">Potentially reclaimable</div>
      <div class="value">{{ (reclaim_mb / 1024) | round(2) }} <small>GB</small></div></div>
  </div>

  <section>
    <h2>Drive {{ u.DriveLetter }}: usage <span class="pill {{ level }}">{{ {'ok': 'Healthy', 'warn': 'Warning', 'crit': 'Critical'}[level] }}</span></h2>
    <p class="desc">{{ ((u.SizeGB | float) - (u.FreeGB | float)) | round(2) }} GB used of {{ u.SizeGB }} GB</p>
    <div class="usage-bar"><div class="{{ level }}" style="width: {{ [pct, 100] | min }}%"></div></div>
    <div class="usage-legend"><span style="left: 0%">0%</span><span style="left: {{ disk_report_html_warn_pct }}%">{{ disk_report_html_warn_pct }}%</span><span style="left: {{ disk_report_html_crit_pct }}%">{{ disk_report_html_crit_pct }}%</span><span style="left: 100%">100%</span></div>
  </section>

  <section>
    <h2>Largest files</h2>
    <p class="desc">Top {{ disk_report_top_n }} files of at least {{ disk_report_min_file_mb }} MB &middot;
      {{ large | length }} found, {{ (large_mb / 1024) | round(2) }} GB total</p>
{% if large %}
    <table>
      <thead><tr><th>Path</th><th style="text-align:right">Size</th><th></th><th>Last modified</th></tr></thead>
      <tbody>
{% for f in large %}
        <tr>
          <td class="path">{{ f.Path | e }}</td>
          <td class="num">{{ '%.1f' | format(f.SizeMB | float) }} MB</td>
          <td><div class="mini"><div style="width: {{ ((f.SizeMB | float) / max_mb * 100) | round(1) }}%"></div></div></td>
          <td class="date">{{ f.LastModified }}</td>
        </tr>
{% endfor %}
      </tbody>
    </table>
{% else %}
    <div class="empty">No files at or above {{ disk_report_min_file_mb }} MB were found.</div>
{% endif %}
  </section>

  <section>
    <h2>{{ disk_report_temp_path | e }} cleanup candidates</h2>
{% if t.Exists %}
    <p class="desc">{{ t.FileCount }} files ({{ t.TotalMB }} MB) in total &middot;
      <strong>{{ t.StaleCount }} files ({{ t.StaleMB }} MB)</strong> older than {{ disk_report_temp_age_days }} days</p>
{% if t.StaleFiles %}
    <table>
      <thead><tr><th>Path</th><th style="text-align:right">Size</th><th>Last modified</th></tr></thead>
      <tbody>
{% for f in t.StaleFiles %}
        <tr>
          <td class="path">{{ f.Path | e }}</td>
          <td class="num">{{ '%.2f' | format(f.SizeMB | float) }} MB</td>
          <td class="date">{{ f.LastModified }}</td>
        </tr>
{% endfor %}
      </tbody>
    </table>
{% if t.StaleCount | int > t.StaleFiles | length %}
    <div class="empty">Showing the largest {{ t.StaleFiles | length }} of {{ t.StaleCount }} files.</div>
{% endif %}
{% else %}
    <div class="empty">No files older than {{ disk_report_temp_age_days }} days.</div>
{% endif %}
{% else %}
    <div class="empty">{{ disk_report_temp_path | e }} does not exist on this host.</div>
{% endif %}
  </section>

  <footer>Generated by Red Hat Ansible Automation Platform</footer>
</main>
</body>
</html>
